# Security-critical key: use a random value with at least 32 chars.
# Example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_unique_64_hex_character_value
# Optional: if omitted, sensitive settings and agent tokens reuse SECRET_KEY.
# SETTINGS_ENCRYPTION_KEY=${SECRET_KEY}

# API docs / OpenAPI are disabled unless explicitly enabled.
ENABLE_API_DOCS=false
